# OpenRouter credentials for the perplexity-search skill.
#
# Copy this file to `.env` and fill in your own key, or let
# `scripts/setup_env.py` write it for you:
#
#     python scripts/setup_env.py --api-key sk-or-v1-xxxxx
#
# The key is read by `scripts/perplexity_search.py` via the OPENROUTER_API_KEY
# environment variable. Never commit a populated `.env` to version control.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: override the default model used for searches.
# OPENROUTER_MODEL=perplexity/sonar-pro
