        <mxCell id="e06" value="临床资料（除外 qPCR 结果）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;fontSize=10;fontColor=#7B1FA2;fontStyle=2;" edge="1" parent="1" source="n05" target="n20">
