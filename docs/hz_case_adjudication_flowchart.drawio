        <!-- EAC Detail Note -->
        <mxCell id="n21" value="&lt;b&gt;EAC 判定流程（截图1）：&lt;/b&gt;&lt;br&gt;① 医学联络人分发资料（除外qPCR）&lt;br&gt;② 各 EAC 专家独立诊断&lt;br&gt;③ 研究团队回复专家疑问&lt;br&gt;④ 医学联络人汇总独立诊断结果&lt;br&gt;⑤ EAC 主席确认最终诊断结果&lt;br&gt;⑥ 意见不一致 → 召开判定会议投票&lt;br&gt;  （半数以上决定结果）" style="text;html=1;align=left;verticalAlign=top;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;spacingBottom=4;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
          <mxGeometry x="880" y="555" width="260" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e_note2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#BBBBBB;" edge="1" parent="1" source="n20" target="n21">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="n22" value="EAC&lt;br&gt;判定结果" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
