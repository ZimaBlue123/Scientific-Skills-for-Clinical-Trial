          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- === PATH 2: EAC Blind Review === -->

        <mxCell id="n20" value="EAC 第一阶段判定&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;（完全未知检测结果的盲评）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#7B1FA2;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
