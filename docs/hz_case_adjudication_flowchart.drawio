        <!-- qPCR result note -->
        <mxCell id="n11_note" value="&lt;b&gt;qPCR 定义：&lt;/b&gt;&lt;br&gt;· 阳性：≥1个样本检测阳性&lt;br&gt;· 真阴性：内参基因(+)，靶基因(-)&lt;br&gt;· 无法判定：内参(-)且靶基因(-)，&lt;br&gt;  或无皮损样本" style="text;html=1;align=left;verticalAlign=top;strokeColor=#1565C0;fillColor=#E3F2FD;fontSize=9;rounded=1;spacingLeft=5;spacingTop=3;spacingRight=5;spacingBottom=3;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
