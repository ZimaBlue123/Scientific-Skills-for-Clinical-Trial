        <!-- Cross-validation Rules Note -->
        <mxCell id="n30_rules" value="&lt;b&gt;判定章程（优先级规则）：&lt;/b&gt;&lt;br&gt;① qPCR 阳性 → 实验室确诊（无论EAC结果）&lt;br&gt;② qPCR 真阴性 → 以 qPCR 为准，排除（qPCR优先于EAC）&lt;br&gt;③ EAC 判"否" + qPCR 非阳性 → 排除&lt;br&gt;④ qPCR 无法判定或无样本 + EAC 判"是" → 进入第二阶段复判" style="text;html=1;align=left;verticalAlign=top;strokeColor=#E65100;fillColor=#FFFFFF;fontSize=10;rounded=1;spacingLeft=6;spacingTop=5;spacingRight=6;spacingBottom=5;strokeWidth=1.5;" vertex="1" parent="1">
