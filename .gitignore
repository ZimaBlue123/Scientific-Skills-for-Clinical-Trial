.worktrees/

# ==========================================
# Data / secrets / outputs
# ==========================================
data/
raw_data/
output/
downloads/
review_materials/
secrets/

# Avoid accidental data source leakage (raw exports often contain PHI/PII)
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
.env
.env.*
!.env.example
config.yaml
config_local.yaml

# Credentials / keys (never commit)
*.pem
*.key
*.p12
credentials*.json
secrets*.json
service_account*.json
*.sqlite3

# ==========================================
# Logs / temp / notebooks
# ==========================================
*.log
*.bak
*.tmp
*.download
*_result.txt
verify_data_result.txt
temp*.txt
*dump*.txt
.ipynb_checkpoints/
~$*

